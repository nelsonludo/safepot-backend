# Create .gitignore
@"
# Dependencies
node_modules/

# Build output
dist/

# Environment variables - NEVER commit this
.env

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Test coverage
coverage/

# TypeORM cache
.typeorm-cache/
"@ | Out-File -FilePath .gitignore -Encoding utf8